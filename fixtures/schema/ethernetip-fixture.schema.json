{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/ethernetip-interop/fixtures/schema/ethernetip-fixture.schema.json",
  "title": "ethernetip-interop fixture",
  "description": "A simulated EtherNet/IP target: identity, assemblies and Logix tags. See docs/FIXTURES.md. The cross-field rules are in scripts/validate-fixtures.py.",
  "type": "object",
  "required": ["schemaVersion", "name", "description", "identity", "assemblies", "echoOutputToInput", "slot", "tags"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "description": { "type": "string", "minLength": 1 },
    "identity": {
      "type": "object",
      "required": ["vendorId", "deviceType", "productCode", "revision", "serialNumber", "productName"],
      "additionalProperties": false,
      "properties": {
        "vendorId": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "deviceType": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "productCode": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "revision": {
          "description": "major.minor, each 0..255 (USINT)",
          "type": "string", "pattern": "^(0|[1-9][0-9]{0,2})\\.(0|[1-9][0-9]{0,2})$"
        },
        "serialNumber": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "productName": {
          "description": "SHORT_STRING; the Identity object allows at most 32 characters",
          "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[\\x20-\\x7e]+$"
        }
      }
    },
    "assemblies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["instance", "kind", "size"],
        "additionalProperties": false,
        "properties": {
          "instance": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "kind": { "enum": ["input", "output", "config", "input-only", "listen-only", "explicit"] },
          "size": { "type": "integer", "minimum": 0, "maximum": 4000 }
        }
      }
    },
    "echoOutputToInput": { "type": "boolean" },
    "slot": { "type": "integer", "minimum": 0, "maximum": 255 },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,39}$" },
          "type": { "enum": ["BOOL", "SINT", "INT", "DINT", "LINT", "USINT", "UINT", "UDINT", "ULINT", "REAL", "LREAL"] },
          "count": { "type": "integer", "minimum": 2, "maximum": 65535 },
          "values": { "type": "array", "minItems": 1, "items": { "type": "number" } },
          "pattern": {
            "type": "object",
            "required": ["multiplier", "offset"],
            "additionalProperties": false,
            "properties": {
              "multiplier": { "type": "number" },
              "offset": { "type": "number" }
            }
          }
        },
        "oneOf": [
          { "required": ["values"], "not": { "required": ["pattern"] } },
          { "required": ["pattern", "count"], "not": { "required": ["values"] } }
        ]
      }
    }
  }
}
