{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/ethernetip-interop/schemas/client-result.schema.json",
  "title": "ethernetip-interop client result document",
  "description": "The single line a 'client' operation prints. See docs/CONTAINER_CONTRACT.md. Consumers ignore fields they do not know.",
  "type": "object",
  "required": ["schemaVersion", "adapter", "operation", "ok", "error"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "adapter": { "type": "string", "minLength": 1 },
    "operation": { "$ref": "#/$defs/operation" },
    "ok": { "type": "boolean" },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "enum": ["connect-failed", "timeout", "connection-lost", "protocol", "failed"] },
            "message": { "type": "string" }
          }
        }
      ]
    },
    "identity": { "$ref": "#/$defs/identity" },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "capabilities"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "capabilities": { "type": "integer", "minimum": 0, "maximum": 65535 }
        }
      }
    },
    "status": { "$ref": "#/$defs/status" },
    "extendedStatus": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 65535 } },
    "data": { "$ref": "#/$defs/hex" },
    "errorText": { "type": ["string", "null"] },
    "replies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["status", "data"],
        "properties": { "status": { "$ref": "#/$defs/status" }, "data": { "$ref": "#/$defs/hex" } }
      }
    },
    "module": { "type": "object" },
    "forwardOpen": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "extendedStatus": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 65535 } },
        "refused": { "type": "boolean" }
      }
    },
    "sent": { "type": "integer", "minimum": 0 },
    "received": { "type": "integer", "minimum": 0 },
    "firstInput": { "$ref": "#/$defs/hex" },
    "lastInput": { "$ref": "#/$defs/hex" },
    "timedOut": { "type": "boolean" },
    "forwardClose": {
      "type": "object",
      "required": ["status"],
      "properties": { "status": { "$ref": "#/$defs/status" }, "error": { "type": "string" } }
    },
    "type": { "type": ["string", "null"] },
    "values": { "$ref": "#/$defs/values" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tag", "values"],
        "properties": {
          "tag": { "type": "string" },
          "values": { "$ref": "#/$defs/values" },
          "status": { "$ref": "#/$defs/status" },
          "errorText": { "type": ["string", "null"] }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "dims"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": ["string", "null"] },
          "dims": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "programName": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": false } } },
      "then": { "properties": { "error": { "type": "object" } } },
      "else": { "properties": { "error": { "type": "null" } } }
    },
    {
      "if": { "properties": { "ok": { "const": true }, "operation": { "enum": ["list-identity", "discover"] } } },
      "then": { "required": ["identity"] }
    },
    {
      "if": { "properties": { "ok": { "const": true }, "operation": { "const": "list-services" } } },
      "then": { "required": ["services"] }
    },
    {
      "if": { "properties": { "ok": { "const": true }, "operation": { "enum": ["get-attribute", "set-attribute", "get-attributes-all"] } } },
      "then": { "required": ["status", "data"] }
    },
    {
      "if": { "properties": { "ok": { "const": true }, "operation": { "const": "multiple-get" } } },
      "then": { "required": ["status"] }
    },
    {
      "if": { "properties": { "ok": { "const": true }, "operation": { "const": "identity" } } },
      "then": { "anyOf": [ { "required": ["identity"] }, { "required": ["module"] } ] }
    },
    {
      "if": { "properties": { "ok": { "const": true }, "operation": { "const": "io" } } },
      "then": { "required": ["forwardOpen"] }
    },
    {
      "if": {
        "properties": { "ok": { "const": true }, "operation": { "const": "io" },
                        "forwardOpen": { "properties": { "status": { "const": 0 } } } },
        "required": ["forwardOpen"]
      },
      "then": { "required": ["sent", "received", "firstInput", "lastInput", "timedOut", "forwardClose"] }
    },
    {
      "if": { "properties": { "ok": { "const": true }, "operation": { "enum": ["read-tag", "write-tag"] } } },
      "then": { "required": ["status"] }
    },
    {
      "if": { "properties": { "ok": { "const": true }, "operation": { "const": "read-tags" } } },
      "then": { "required": ["results"] }
    },
    {
      "if": { "properties": { "ok": { "const": true }, "operation": { "const": "tag-list" } } },
      "then": { "required": ["tags"] }
    }
  ],
  "$defs": {
    "operation": {
      "enum": ["list-identity", "discover", "list-services", "get-attribute", "set-attribute", "get-attributes-all",
               "multiple-get", "identity", "io", "read-tag", "read-tags", "write-tag", "tag-list"]
    },
    "hex": { "type": "string", "pattern": "^([0-9a-f]{2})*$" },
    "status": {
      "description": "A CIP general status, 0 for success; -1 where the stack reports a failure without one (see docs/CONTAINER_CONTRACT.md).",
      "type": "integer", "minimum": -1, "maximum": 255
    },
    "values": {
      "type": "array",
      "items": { "type": ["number", "boolean", "string", "null"] }
    },
    "identity": {
      "type": "object",
      "required": ["vendorId", "deviceType", "productCode", "revision", "status", "serialNumber", "productName", "socketAddress"],
      "properties": {
        "vendorId": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 },
        "vendorName": { "type": ["string", "null"] },
        "deviceType": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 },
        "productCode": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "revision": { "type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}$" },
        "status": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 },
        "serialNumber": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "productName": { "type": "string" },
        "state": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
        "socketAddress": { "type": ["string", "null"] }
      }
    }
  }
}
